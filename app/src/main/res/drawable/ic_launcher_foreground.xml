<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer HUD Radar Ring (Electric Cyan) -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 26.5,66"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#00F5D4" />

    <!-- Secondary Accent Arc (Neon Lime) -->
    <path
        android:pathData="M25,58 A30,30 0 0,1 46,25.2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#B8FF00" />

    <!-- Sleek Modern Navigation Chevron (Left Wing - Bright Cyan) -->
    <path android:pathData="M54,32 L36,70 L54,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="32"
                android:endX="36"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.4" android:color="#00F5D4" />
                <item android:offset="1.0" android:color="#00BBF9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek Modern Navigation Chevron (Right Wing - Electric Violet/Cyan Shaded) -->
    <path android:pathData="M54,32 L72,70 L54,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="32"
                android:endX="72"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F5D4" />
                <item android:offset="1.0" android:color="#7B2CBF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Speed-Trail Core Dot -->
    <path
        android:pathData="M54,73m-2.5,0a2.5,2.5 0,1 1,5 0a2.5,2.5 0,1 1,-5 0"
        android:fillColor="#B8FF00" />
</vector>
